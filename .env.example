# Copy to apps/api/.env and apps/web/.env and fill in real values.
# NEVER commit the real files. Only this example file is tracked by Git.

# ---------- apps/api/.env (server only) ----------
NODE_ENV=development
PORT=4000
# Browser origin allowed by CORS (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# Supabase project values (Project Settings > API)
SUPABASE_URL=
# Public anon key: used with the user's JWT so Row Level Security applies
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS. Not used by the document features (they use the signed-in user's
# client, so signed URLs and storage follow the same Row Level Security). Leave empty.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio key). Model name is configurable because Google retires models.
# If either value is empty the server still starts, and POST /api/documents/:id/process
# answers 503 AI_NOT_CONFIGURED.
GEMINI_API_KEY=
GEMINI_MODEL=

# ---------- apps/web/.env (public: everything here ends up in the browser) ----------
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
